# Optional. Client forms (Contact page + custom package brief) are emailed to keffinicreativestudio@gmail.com
# through FormSubmit by default (see src/utils/enquiry.ts). Set this only to use a different relay.
VITE_CONTACT_ENDPOINT=

# NVIDIA NIM AI Model (build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Client-side Vite environment variables
VITE_NVIDIA_API_KEY=your_nvidia_api_key_here
VITE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
VITE_NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
